{
  "//": "internet_dungeon.theme.json の形の宣言（Studio の sections 方言）。昼と夜で色票を分けて持つ（画風が違うので共有しない）。色 1 つ = type color のフィールド。派生色（つや・影）はコードで導くので増やさない。塗りの仕上げは入れ子 1 段の record にまとめる。",
  "version": 1,
  "sections": {
    "day": {
      "kind": "record",
      "label": "昼の色（自室）",
      "order": 1,
      "fields": {
        "base":   { "type": "color", "label": "下地（壁紙）",           "order": 1 },
        "main":   { "type": "color", "label": "主役（太い輪郭と文字）", "order": 2 },
        "accent": { "type": "color", "label": "差し色（西日）",         "order": 3 }
      }
    },
    "night": {
      "kind": "record",
      "label": "夜の色（インターネット）",
      "order": 2,
      "fields": {
        "base":   { "type": "color", "label": "下地（基板の闇）",             "order": 1 },
        "main":   { "type": "color", "label": "主役（端末のシアン＝ドット絵）", "order": 2 },
        "accent": { "type": "color", "label": "差し色（通知のピンク）",       "order": 3 }
      }
    },
    "puzzle": {
      "kind": "record",
      "label": "パズルのキャンディ 6 色",
      "order": 3,
      "fields": {
        "red":    { "type": "color", "label": "赤（ハート）",                 "order": 1 },
        "orange": { "type": "color", "label": "橙（パレットの木地の素）",     "order": 2 },
        "yellow": { "type": "color", "label": "黄（鉛筆の軸）",               "order": 3 },
        "green":  { "type": "color", "label": "緑（消しゴムのスリーブ）",     "order": 4 },
        "blue":   { "type": "color", "label": "青（絵の具のキャップ）",       "order": 5 },
        "purple": { "type": "color", "label": "紫（お邪魔の染みの素）",       "order": 6 },
        "pink":   { "type": "color", "label": "ピンク（つかんだ駒の枠・入れ替えの向きの矢印）", "order": 7 }
      }
    },
    "pad": {
      "kind": "record",
      "label": "コントローラーのボタンの色（Xbox の配色）",
      "description": "コントローラーで遊んでいるとき、操作の案内に出る丸ボタンの色。昼夜どちらの画面でもこの色（夜の 3 色の例外）。",
      "order": 4,
      "fields": {
        "a": { "type": "color", "label": "A（決定）",                   "order": 1 },
        "b": { "type": "color", "label": "B（戻る・長押しでスキップ）", "order": 2 },
        "x": { "type": "color", "label": "X（デッキ一覧）",             "order": 3 },
        "y": { "type": "color", "label": "Y（情報・ろくが）",           "order": 4 }
      }
    },
    "shade": {
      "kind": "record",
      "label": "ドット絵の仕上げ",
      "order": 5,
      "fields": {
        "rim":        { "type": "float", "label": "ふち光（光の側の縁を明るく）",   "order": 1, "min": 0, "max": 1, "default": 1.0 },
        "contact":    { "type": "float", "label": "接地影（影の側の縁を暗く）",     "order": 2, "min": 0, "max": 1, "default": 1.0 },
        "dither":     { "type": "float", "label": "ディザ（明暗の境を市松に散らす）", "order": 3, "min": 0, "max": 1, "default": 0.6 },
        "grain":      { "type": "float", "label": "粒（面の内側に明暗の点）",       "order": 4, "min": 0, "max": 1, "default": 0.0 },
        "grainScale": { "type": "int",   "label": "粒の粗さ（大きいほど塊になる）", "order": 5, "min": 1, "max": 4, "default": 1 },
        "lightX":     { "type": "int",   "label": "光の向き・横（-1 左 / 0 なし / +1 右）", "order": 6, "min": -1, "max": 1, "default": -1 },
        "lightY":     { "type": "int",   "label": "光の向き・縦（-1 上 / 0 なし / +1 下）", "order": 7, "min": -1, "max": 1, "default": -1 }
      }
    }
  }
}
